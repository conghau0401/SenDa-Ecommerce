// Prisma schema – Sen Đá Shop
// Dev dùng SQLite. Muốn chuyển PostgreSQL: đổi provider = "postgresql" và DATABASE_URL.
// Các trạng thái được lưu dạng String (validate bằng zod ở src/lib/constants.ts) để dễ di chuyển giữa các DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id              Int            @id @default(autoincrement())
  name            String
  slug            String         @unique
  sku             String?
  searchText      String         @default("") // tên + SKU bỏ dấu, chữ thường – phục vụ tìm kiếm
  price           Int // VNĐ
  salePrice       Int? // VNĐ, null = không khuyến mãi
  finalPrice      Int // = salePrice ?? price. Lưu sẵn để lọc/sắp xếp theo giá thực bán
  stock           Int            @default(0)
  shortDesc       String?
  description     String         @default("") // HTML (đã sanitize khi render)
  careGuide       String         @default("") // HTML
  categoryId      Int?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  orderItems      OrderItem[]
  isActive        Boolean        @default(true)
  showOnHome      Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  isNew           Boolean        @default(false)
  sortOrder       Int            @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, showOnHome])
  @@index([createdAt])
  @@index([finalPrice])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  customerName  String
  phone         String
  address       String
  note          String?
  paymentMethod String      @default("COD") // COD | BANK_TRANSFER
  status        String      @default("NEW") // NEW | CONFIRMED | SHIPPING | COMPLETED | CANCELLED
  subtotal      Int
  shippingFee   Int
  total         Int
  internalNote  String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([phone])
  @@index([status, createdAt])
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String // snapshot tại thời điểm đặt
  productImage String?
  price        Int // đơn giá thực tế tại thời điểm đặt
  quantity     Int
}

model Post {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @default("") // HTML
  coverImage      String?
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String // SĐT hoặc email
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
}

// Key-value, value là JSON string. Xem src/lib/settings.ts
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------------------
// Chatbot
// ------------------------------------------------------------------

model ChatConversation {
  id              Int           @id @default(autoincrement())
  sessionId       String        @unique // UUID lưu ở localStorage của khách
  context         String        @default("{}") // JSON: trạng thái hội thoại (đang chờ mã đơn/SĐT...)
  messageCount    Int           @default(0)
  unansweredCount Int           @default(0) // số câu bot chưa hiểu
  isReviewed      Boolean       @default(true) // false khi có câu chưa trả lời mà admin chưa xem
  pagePath        String? // trang khách mở chat lần đầu
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  messages        ChatMessage[]

  @@index([lastMessageAt])
  @@index([isReviewed])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | bot
  content        String
  intent         String? // ý định nhận diện được (bot)
  source         String? // rule | faq | ai (bot)
  answered       Boolean          @default(true) // false = bot không hiểu câu hỏi
  payload        String? // JSON: sản phẩm gợi ý, nút trả lời nhanh, liên kết
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([intent])
}

// Kiến thức hỏi – đáp, admin chỉnh sửa được
model ChatFaq {
  id        Int      @id @default(autoincrement())
  question  String // câu hỏi mẫu (hiển thị)
  keywords  String // cụm từ khóa, phân tách bằng dấu phẩy
  answer    String // hỗ trợ **đậm**, [liên kết](/duong-dan), xuống dòng, "- " gạch đầu dòng
  category  String   @default("chung")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
