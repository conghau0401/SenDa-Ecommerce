DATABASE_URL="file:./dev.db"
# Chuỗi bí mật để ký cookie phiên admin (>= 32 ký tự). ĐỔI khi deploy.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Tài khoản admin được tạo khi chạy seed
ADMIN_EMAIL="25210281@ms.uit.edu.vn"
ADMIN_PASSWORD="25210281"
# URL gốc của site (dùng cho sitemap, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Chatbot: "on" để Claude diễn đạt câu trả lời tự nhiên hơn (mặc định "off" = chỉ dùng luật + kiến thức, miễn phí)
CHATBOT_AI="off"
# Model dùng cho chatbot khi bật AI
CHATBOT_AI_MODEL="claude-opus-5-5"
# Khóa API Anthropic (https://console.anthropic.com) – chỉ cần khi CHATBOT_AI="on".
# Bỏ dấu # và điền khóa. Để trống thì SDK dùng profile từ lệnh `ant auth login` (nếu có).
# ANTHROPIC_API_KEY="sk-ant-..."
